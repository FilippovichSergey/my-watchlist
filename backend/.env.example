# Loaded automatically by Spring when running from the backend/ directory (spring.config.import).
# Real environment variables always win over this file.
DATABASE_URL=jdbc:postgresql://localhost:5434/watchlist
DATABASE_USER=watchlist
DATABASE_PASSWORD=watchlist

# TMDB: prefer the v4 "API Read Access Token" (sent as an Authorization header).
TMDB_ACCESS_TOKEN=
# Legacy v3 key, used only while TMDB_ACCESS_TOKEN is empty (it travels in the URL).
TMDB_API_KEY=

# The same Google OAuth client ID the frontend uses; tokens issued for other clients are rejected.
GOOGLE_CLIENT_ID=your-google-client-id
# Verified Google accounts allowed to modify the list, comma-separated.
ADMIN_EMAILS=you@gmail.com
# Preferred: Google account ids (the stable "sub" claim) allowed to modify the list, comma-separated.
# Shown on the admin page after the first e-mail-based sign-in. One of the two lists must be set.
ADMIN_GOOGLE_SUBS=
