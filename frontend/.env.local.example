# Auth.js session encryption key. Generate with: openssl rand -base64 32
AUTH_SECRET=your-random-secret-here

# Google OAuth 2.0 client (type "Web application").
# Authorized redirect URI: <site origin>/api/auth/callback/google
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=

# Verified Google accounts allowed to sign in and manage the list, comma-separated.
# Keep in sync with ADMIN_EMAILS in the backend.
ADMIN_EMAILS=you@gmail.com
# Preferred: Google account ids (the stable "sub" claim) allowed in, comma-separated. The admin page
# shows yours after the first e-mail-based sign-in. Keep in sync with the backend.
ADMIN_GOOGLE_SUBS=

# Spring Boot backend; only the Next.js server talks to it, never the browser.
BACKEND_URL=http://localhost:8080

# Optional. The public origin of the site, e.g. https://my-watchlist-sf.vercel.app. When set, admin
# write routes accept requests from exactly this origin (scheme, host, port). When empty, the origin is
# derived from the request; proxy headers are trusted only on Vercel or with AUTH_TRUST_HOST=true.
APP_ORIGIN=
